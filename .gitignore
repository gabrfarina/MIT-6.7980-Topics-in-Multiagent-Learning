# Only the public course source directories belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Makefile
!/html-export.json
!/content/
!/syllabus/
!/html-exporter/
!/scripts/
!/website/
!/docs/
!/slides/
!/.vscode/
# Publish configured course slides, while keeping editable deck sources private.
/slides/*
!/slides/L00_course_intro.pdf
!/slides/L01_nash_equilibrium.pdf
!/slides/L02_sperner.pdf
!/slides/L03_nash_properties.pdf
!/slides/L04_learning_in_games.pdf
!/slides/L04_learning_in_games.html
!/slides/L05_learning_in_games.pdf
!/slides/L05_learning_in_games.html

# Build products, editor state, and local secrets.
**/target/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env
**/.env.*
**/*~
**/.ipynb_checkpoints/
content/.*-check/
content/*.pdf
syllabus/macros.pdf
/syllabus/6.7980 Fall 2026 Syllabus.pdf

# Private migration records stay in the local workspace.
/private/
/docs/migration/
/migration/

# Local MIT locker deployment tooling and notes.
/deploy/
